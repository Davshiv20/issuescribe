# Works with OpenAI directly, or any OpenAI-compatible provider.
# For OpenRouter: set OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# use an sk-or-... key, and a vendor-prefixed model like openai/gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=file:./issuescribe.db

NODE_ENV=development
