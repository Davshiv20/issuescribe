{
  "name": "issuescribe",
  "version": "0.1.0",
  "description": "Create GitHub issues from plain text inside Discord.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "register:commands": "bun run src/discord/registerCommands.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "test": "bun test"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "discord.js": "^14.26.4",
    "openai": "^6.45.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
